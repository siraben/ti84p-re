# Run ASTRIN = Asm(prgmSTRIN), drain ENTER, then submit the expression 1.
set key_hold 0.15s
set key_delay 0.10s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key PRGM
wait 0.6s
key ENTER
wait 0.8s
key ENTER
wait 2s
key ENTER
wait 2s
key 1
wait 0.5s
key ENTER
wait 6s
memdump /tmp/community-string-input.ram ram-logical
screenshot /tmp/community-string-input.png
