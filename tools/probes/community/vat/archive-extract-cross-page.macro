# Recover the record at 08:7FE0 whose data crosses into page 09 as RCVCROSS.
set key_hold 0.15s
set key_delay 0.10s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key PRGM
wait 0.6s
key ENTER
wait 0.8s
key ENTER
wait 3s
key MUL
wait 1s
key 0
wait 0.2s
key 8
wait 0.2s
key 7
wait 0.2s
key COS
wait 0.2s
key SIN
wait 0.2s
key 0
wait 1s
key MUL
wait 0.2s
key PRGM
wait 0.2s
key 6
wait 0.2s
key PRGM
wait 0.2s
key MUL
wait 0.2s
key 7
wait 0.2s
key LN
wait 0.2s
key LN
key ENTER
wait 5s
memdump /tmp/community-archive-extract-cross-page.ram ram-logical
memdump /tmp/community-archive-extract-cross-page.rom rom
screenshot /tmp/community-archive-extract-cross-page.png
