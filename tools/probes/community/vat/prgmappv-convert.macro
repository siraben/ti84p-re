# Run the repackaged, byte-identical PRGMAPPV body and convert the sole
# selected ordinary program to an AppVar.
set key_hold 0.15s
set key_delay 0.10s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key PRGM
wait 0.6s
key ENTER
wait 0.8s
key ENTER
wait 3s
key APPS
wait 4s
memdump /tmp/community-prgmappv-convert.ram ram-logical
screenshot /tmp/community-prgmappv-convert.png
key CLEAR
wait 1s
