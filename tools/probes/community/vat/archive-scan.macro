# Run packaged Archive Utility against a fixture containing adjacent live and
# dead records, choose Scan (LN), and capture the displayed scan plus VAT/RAM.
set key_hold 0.15s
set key_delay 0.10s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key PRGM
wait 0.6s
key ENTER
wait 0.8s
key ENTER
wait 3s
key LN
wait 5s
memdump /tmp/community-archive-scan.ram ram-logical
screenshot /tmp/community-archive-scan.png
