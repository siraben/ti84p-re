# Walk left through all four children of a completed integral.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key MATH
key 9
key 1
key RIGHT
wait 0.35s
key 2
key RIGHT
wait 0.35s
key GRAPHVAR
key RIGHT
wait 0.35s
key GRAPHVAR
key RIGHT
wait 0.5s
memdump /tmp/mp-integral-left-walk-0.ram ram-logical
screenshot /tmp/mp-integral-left-walk-0.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-1.ram ram-logical
screenshot /tmp/mp-integral-left-walk-1.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-2.ram ram-logical
screenshot /tmp/mp-integral-left-walk-2.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-3.ram ram-logical
screenshot /tmp/mp-integral-left-walk-3.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-4.ram ram-logical
screenshot /tmp/mp-integral-left-walk-4.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-5.ram ram-logical
screenshot /tmp/mp-integral-left-walk-5.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-6.ram ram-logical
screenshot /tmp/mp-integral-left-walk-6.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-7.ram ram-logical
screenshot /tmp/mp-integral-left-walk-7.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-8.ram ram-logical
screenshot /tmp/mp-integral-left-walk-8.png
key LEFT
wait 0.4s
memdump /tmp/mp-integral-left-walk-9.ram ram-logical
screenshot /tmp/mp-integral-left-walk-9.png
