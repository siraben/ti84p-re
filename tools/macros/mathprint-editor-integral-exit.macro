# Capture the top-level cursor immediately after a completed integral marker.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key MATH
key 9
key 1
key RIGHT
wait 0.35s
key 2
key RIGHT
wait 0.35s
key GRAPHVAR
key RIGHT
wait 0.35s
key GRAPHVAR
wait 0.6s
memdump /tmp/mathprint-editor-integral-exit.ram ram-logical
screenshot /tmp/mathprint-editor-integral-exit.png
