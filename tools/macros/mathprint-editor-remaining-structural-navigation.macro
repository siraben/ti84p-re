screenshot /tmp/mp-power-left-walk-5.png
memdump /tmp/mp-power-right-walk-0.ram ram-logical
screenshot /tmp/mp-power-right-walk-0.png
key RIGHT
wait 0.4s
memdump /tmp/mp-power-right-walk-1.ram ram-logical
screenshot /tmp/mp-power-right-walk-1.png
key RIGHT
wait 0.4s
memdump /tmp/mp-power-right-walk-2.ram ram-logical
screenshot /tmp/mp-power-right-walk-2.png
