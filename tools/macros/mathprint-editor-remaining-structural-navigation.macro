wait 0.4s
memdump /tmp/mp-power-right-walk-3.ram ram-logical
screenshot /tmp/mp-power-right-walk-3.png
key RIGHT
wait 0.4s
memdump /tmp/mp-power-right-walk-4.ram ram-logical
screenshot /tmp/mp-power-right-walk-4.png
key RIGHT
wait 0.4s
memdump /tmp/mp-power-right-walk-5.ram ram-logical
screenshot /tmp/mp-power-right-walk-5.png

