key CLEAR
key MATH
key RIGHT
key 1
key GRAPHVAR
key RIGHT
wait 0.5s
memdump /tmp/mp-absolute-left-walk-0.ram ram-logical
screenshot /tmp/mp-absolute-left-walk-0.png
