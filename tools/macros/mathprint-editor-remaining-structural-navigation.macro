# Walk both directions through completed radical, nth-root, and power templates.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s

# sqrt(2): root-after to root-before and back.
key CLEAR
key 2ND
key SQUARE
key 2
key RIGHT
wait 0.5s
memdump /tmp/mp-radical-left-walk-0.ram ram-logical
screenshot /tmp/mp-radical-left-walk-0.png
key LEFT
wait 0.4s
memdump /tmp/mp-radical-left-walk-1.ram ram-logical
screenshot /tmp/mp-radical-left-walk-1.png
key LEFT
wait 0.4s
memdump /tmp/mp-radical-left-walk-2.ram ram-logical
screenshot /tmp/mp-radical-left-walk-2.png
key LEFT
wait 0.4s
memdump /tmp/mp-radical-left-walk-3.ram ram-logical
screenshot /tmp/mp-radical-left-walk-3.png
key LEFT
wait 0.4s
memdump /tmp/mp-radical-left-walk-4.ram ram-logical
screenshot /tmp/mp-radical-left-walk-4.png
memdump /tmp/mp-radical-right-walk-0.ram ram-logical
screenshot /tmp/mp-radical-right-walk-0.png
key RIGHT
wait 0.4s
memdump /tmp/mp-radical-right-walk-1.ram ram-logical
screenshot /tmp/mp-radical-right-walk-1.png
key RIGHT
wait 0.4s
memdump /tmp/mp-radical-right-walk-2.ram ram-logical
screenshot /tmp/mp-radical-right-walk-2.png
key RIGHT
wait 0.4s
memdump /tmp/mp-radical-right-walk-3.ram ram-logical
screenshot /tmp/mp-radical-right-walk-3.png
key RIGHT
wait 0.4s
memdump /tmp/mp-radical-right-walk-4.ram ram-logical
screenshot /tmp/mp-radical-right-walk-4.png

# root(Ans,2): retain the constructor's Ans index and walk both children.
key CLEAR
key MATH
key 5
key 2
key RIGHT
wait 0.5s
memdump /tmp/mp-nthroot-left-walk-0.ram ram-logical
screenshot /tmp/mp-nthroot-left-walk-0.png
key LEFT
wait 0.4s
memdump /tmp/mp-nthroot-left-walk-1.ram ram-logical
screenshot /tmp/mp-nthroot-left-walk-1.png
