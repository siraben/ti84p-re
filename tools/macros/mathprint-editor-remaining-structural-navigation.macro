wait 0.4s
memdump /tmp/mp-nthroot-left-walk-4.ram ram-logical
screenshot /tmp/mp-nthroot-left-walk-4.png
key LEFT
wait 0.4s
memdump /tmp/mp-nthroot-left-walk-5.ram ram-logical
screenshot /tmp/mp-nthroot-left-walk-5.png
key LEFT
wait 0.4s
memdump /tmp/mp-nthroot-left-walk-6.ram ram-logical
screenshot /tmp/mp-nthroot-left-walk-6.png
memdump /tmp/mp-nthroot-right-walk-0.ram ram-logical
screenshot /tmp/mp-nthroot-right-walk-0.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nthroot-right-walk-1.ram ram-logical
screenshot /tmp/mp-nthroot-right-walk-1.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nthroot-right-walk-2.ram ram-logical
screenshot /tmp/mp-nthroot-right-walk-2.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nthroot-right-walk-3.ram ram-logical
screenshot /tmp/mp-nthroot-right-walk-3.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nthroot-right-walk-4.ram ram-logical
screenshot /tmp/mp-nthroot-right-walk-4.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nthroot-right-walk-5.ram ram-logical
screenshot /tmp/mp-nthroot-right-walk-5.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nthroot-right-walk-6.ram ram-logical
screenshot /tmp/mp-nthroot-right-walk-6.png

# Ans^2: include movement across the implicit root-leaf base.
key CLEAR
key POWER
key 2
key RIGHT
wait 0.5s
memdump /tmp/mp-power-left-walk-0.ram ram-logical
screenshot /tmp/mp-power-left-walk-0.png
