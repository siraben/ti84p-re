# Run a TI-BASIC wrapper named ASCRATCH whose body is Asm(prgmSCRPROBE).
# Build the wrapper with tools/build_scratch_probe_wrapper.py and load it with
# SCRPROBE.8xp. The payload leaves its checked result in a halted state.
# The ON press exercises ON-key handling while _GetKey waits with APD disabled.
# The fixture then checks both guards and prints SAVE STAT followed by 1 for an
# intact range or 0 for a modified range.
set key_hold 0.20s
set key_delay 0.10s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key PRGM
wait 0.6s
key ENTER
wait 0.8s
key ENTER
wait 3s
key ON
wait 2s
screenshot /tmp/scratch-guard-result.png
memdump /tmp/scratch-guard-on-logical.ram ram-logical
memdump /tmp/scratch-guard-on-physical.ram ram
