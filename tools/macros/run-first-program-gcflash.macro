# Power on, run the first program in PRGM > EXEC, then accept the
# GarbageCollect confirmation prompt produced by the GCFLASH fixture.
set key_hold 0.15s
set key_delay 0.08s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key PRGM
wait 0.6s
key ENTER
wait 0.8s
key ENTER
wait 9s
key 2
key ENTER
wait 6s
screenshot /tmp/tibasic-gcflash.png
