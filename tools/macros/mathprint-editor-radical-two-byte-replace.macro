# Capture radical-template replacement of a two-byte L1 token.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key 3
key 2ND
key 1
key LEFT
wait 0.6s
memdump /tmp/mathprint-editor-radical-two-byte-replace-pre.ram ram-logical
screenshot /tmp/mathprint-editor-radical-two-byte-replace-pre.png
key 2ND
key SQUARE
wait 0.8s
memdump /tmp/mathprint-editor-radical-two-byte-replace-post.ram ram-logical
screenshot /tmp/mathprint-editor-radical-two-byte-replace-post.png
