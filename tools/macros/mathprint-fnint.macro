# MathPrint: render the filled integral int(1,2,X^2,X).
# This drives the page-39 handler-record path and the subexpression emitter at
# 39:4CA4. Exact trace-point checks distinguish routine entries from the
# resolver's nearest-symbol function buckets.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key MATH
key 9
key 1
key RIGHT
wait 0.35s
key 2
key RIGHT
wait 0.35s
key GRAPHVAR
key POWER
key 2
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key GRAPHVAR
wait 0.6s
screenshot /tmp/mathprint-fnint.png
memdump /tmp/mathprint-fnint.ram ram-logical
