# Capture deletion of the token under an ordinary root-leaf cursor.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key 1
key 2
key LEFT
wait 0.6s
memdump /tmp/mathprint-editor-root-delete-pre.ram ram-logical
screenshot /tmp/mathprint-editor-root-delete-pre.png
key DEL
wait 0.6s
memdump /tmp/mathprint-editor-root-delete-post.ram ram-logical
screenshot /tmp/mathprint-editor-root-delete-post.png
