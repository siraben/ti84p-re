# Power on after reset, open MEM > Mem Mgmt/Del > Prgm, select the second
# listed program, and archive it. Load exactly two unarchived programs before
# using this fixture.
set key_hold 0.15s
set key_delay 0.10s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR

key 2ND
key ADD
wait 0.6s
key 2
wait 0.6s
key 7
wait 0.8s
key DOWN
wait 0.4s
key ENTER
wait 10s
screenshot /tmp/tilem-archive-second-program.png
