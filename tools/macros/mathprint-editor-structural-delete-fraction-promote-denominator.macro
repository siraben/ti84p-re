# Delete an empty numerator and promote its populated denominator.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key ALPHA
key YEQU
key 1
wait 0.5s
key DOWN
key 2
key UP
wait 0.6s
memdump /tmp/mathprint-editor-structural-delete-fraction-promote-denominator-pre.ram ram-logical
screenshot /tmp/mathprint-editor-structural-delete-fraction-promote-denominator-pre.png
key DEL
wait 0.8s
memdump /tmp/mathprint-editor-structural-delete-fraction-promote-denominator-post.ram ram-logical
screenshot /tmp/mathprint-editor-structural-delete-fraction-promote-denominator-post.png
