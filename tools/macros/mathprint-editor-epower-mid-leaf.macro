# Capture e-power insertion between two root tokens.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key 1
key 2
key LEFT
wait 0.6s
memdump /tmp/mathprint-editor-epower-mid-leaf-pre.ram ram-logical
screenshot /tmp/mathprint-editor-epower-mid-leaf-pre.png
key 2ND
key LN
wait 0.8s
memdump /tmp/mathprint-editor-epower-mid-leaf-post.ram ram-logical
screenshot /tmp/mathprint-editor-epower-mid-leaf-post.png
