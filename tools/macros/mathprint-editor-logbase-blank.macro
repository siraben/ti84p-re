# Capture log-base insertion into a blank root leaf.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
wait 0.6s
memdump /tmp/mathprint-editor-logbase-blank-pre.ram ram-logical
screenshot /tmp/mathprint-editor-logbase-blank-pre.png
key MATH
key ALPHA
key MATH
wait 0.8s
memdump /tmp/mathprint-editor-logbase-blank-post.ram ram-logical
screenshot /tmp/mathprint-editor-logbase-blank-post.png
