# Walk both directions through completed nDeriv( and log-base templates.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s

# nDeriv(X,X,1): capture root-after to root-before and back.
key CLEAR
key MATH
key 8
key GRAPHVAR
key GRAPHVAR
key RIGHT
key 1
key RIGHT
wait 0.5s
memdump /tmp/mp-nderiv-left-walk-0.ram ram-logical
screenshot /tmp/mp-nderiv-left-walk-0.png
key LEFT
wait 0.4s
memdump /tmp/mp-nderiv-left-walk-1.ram ram-logical
screenshot /tmp/mp-nderiv-left-walk-1.png
key LEFT
wait 0.4s
memdump /tmp/mp-nderiv-left-walk-2.ram ram-logical
screenshot /tmp/mp-nderiv-left-walk-2.png
key LEFT
wait 0.4s
memdump /tmp/mp-nderiv-left-walk-3.ram ram-logical
screenshot /tmp/mp-nderiv-left-walk-3.png
key LEFT
wait 0.4s
memdump /tmp/mp-nderiv-left-walk-4.ram ram-logical
screenshot /tmp/mp-nderiv-left-walk-4.png
key LEFT
wait 0.4s
memdump /tmp/mp-nderiv-left-walk-5.ram ram-logical
screenshot /tmp/mp-nderiv-left-walk-5.png
key LEFT
wait 0.4s
memdump /tmp/mp-nderiv-left-walk-6.ram ram-logical
screenshot /tmp/mp-nderiv-left-walk-6.png
key LEFT
wait 0.4s
memdump /tmp/mp-nderiv-left-walk-7.ram ram-logical
screenshot /tmp/mp-nderiv-left-walk-7.png
memdump /tmp/mp-nderiv-right-walk-0.ram ram-logical
screenshot /tmp/mp-nderiv-right-walk-0.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nderiv-right-walk-1.ram ram-logical
screenshot /tmp/mp-nderiv-right-walk-1.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nderiv-right-walk-2.ram ram-logical
screenshot /tmp/mp-nderiv-right-walk-2.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nderiv-right-walk-3.ram ram-logical
screenshot /tmp/mp-nderiv-right-walk-3.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nderiv-right-walk-4.ram ram-logical
screenshot /tmp/mp-nderiv-right-walk-4.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nderiv-right-walk-5.ram ram-logical
screenshot /tmp/mp-nderiv-right-walk-5.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nderiv-right-walk-6.ram ram-logical
screenshot /tmp/mp-nderiv-right-walk-6.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nderiv-right-walk-7.ram ram-logical
screenshot /tmp/mp-nderiv-right-walk-7.png

# logBASE(2,8): capture root-after to root-before and back.
key CLEAR
key MATH
key ALPHA
key MATH
key 2
key RIGHT
key 8
key RIGHT
wait 0.5s
memdump /tmp/mp-logbase-left-walk-0.ram ram-logical
screenshot /tmp/mp-logbase-left-walk-0.png
key LEFT
wait 0.4s
