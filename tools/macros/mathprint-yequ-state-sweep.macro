# Capture the Y= editor state around each directional action.  The snapshots
# expose cxCurApp at 859Ah and tblFlags at IY+13h (8A03h on this OS).
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key YEQU
wait 1s
memdump /tmp/mp-yequ-state-00-entry.ram ram-logical
screenshot /tmp/mp-yequ-state-00-entry.png

key CLEAR
key GRAPHVAR
key POWER
key 2
key RIGHT
wait 0.5s
memdump /tmp/mp-yequ-state-01-power-end.ram ram-logical
screenshot /tmp/mp-yequ-state-01-power-end.png

key LEFT
wait 0.4s
memdump /tmp/mp-yequ-state-02-left-1.ram ram-logical
screenshot /tmp/mp-yequ-state-02-left-1.png
key LEFT
wait 0.4s
memdump /tmp/mp-yequ-state-03-left-2.ram ram-logical
screenshot /tmp/mp-yequ-state-03-left-2.png
key LEFT
wait 0.4s
memdump /tmp/mp-yequ-state-04-left-3.ram ram-logical
screenshot /tmp/mp-yequ-state-04-left-3.png
key LEFT
wait 0.4s
memdump /tmp/mp-yequ-state-05-left-4.ram ram-logical
screenshot /tmp/mp-yequ-state-05-left-4.png
key LEFT
wait 0.4s
memdump /tmp/mp-yequ-state-06-left-5.ram ram-logical
screenshot /tmp/mp-yequ-state-06-left-5.png
key LEFT
wait 0.4s
memdump /tmp/mp-yequ-state-07-left-6.ram ram-logical
screenshot /tmp/mp-yequ-state-07-left-6.png

key RIGHT
wait 0.4s
memdump /tmp/mp-yequ-state-08-right-1.ram ram-logical
screenshot /tmp/mp-yequ-state-08-right-1.png
key RIGHT
wait 0.4s
memdump /tmp/mp-yequ-state-09-right-2.ram ram-logical
screenshot /tmp/mp-yequ-state-09-right-2.png
key RIGHT
wait 0.4s
memdump /tmp/mp-yequ-state-10-right-3.ram ram-logical
screenshot /tmp/mp-yequ-state-10-right-3.png
key RIGHT
wait 0.4s
memdump /tmp/mp-yequ-state-11-right-4.ram ram-logical
screenshot /tmp/mp-yequ-state-11-right-4.png
key RIGHT
wait 0.4s
memdump /tmp/mp-yequ-state-12-right-5.ram ram-logical
screenshot /tmp/mp-yequ-state-12-right-5.png
key RIGHT
wait 0.4s
memdump /tmp/mp-yequ-state-13-right-6.ram ram-logical
screenshot /tmp/mp-yequ-state-13-right-6.png

key UP
wait 0.4s
memdump /tmp/mp-yequ-state-14-up.ram ram-logical
screenshot /tmp/mp-yequ-state-14-up.png
key DOWN
wait 0.4s
memdump /tmp/mp-yequ-state-15-down.ram ram-logical
screenshot /tmp/mp-yequ-state-15-down.png
