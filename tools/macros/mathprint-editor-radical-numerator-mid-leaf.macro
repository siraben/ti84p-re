# Capture radical-template insertion between two outer-numerator tokens.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key ALPHA
key YEQU
wait 0.4s
key 1
wait 0.35s
key 1
key 2
key LEFT
wait 0.6s
memdump /tmp/mathprint-editor-radical-numerator-mid-leaf-pre.ram ram-logical
screenshot /tmp/mathprint-editor-radical-numerator-mid-leaf-pre.png
key 2ND
key SQUARE
wait 0.8s
memdump /tmp/mathprint-editor-radical-numerator-mid-leaf-post.ram ram-logical
screenshot /tmp/mathprint-editor-radical-numerator-mid-leaf-post.png
