# Capture the structural editor transition that creates an empty fraction.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
wait 0.6s
memdump /tmp/mathprint-editor-fraction-construct-pre.ram ram-logical
screenshot /tmp/mathprint-editor-fraction-construct-pre.png
key ALPHA
key YEQU
wait 0.4s
key 1
wait 0.8s
memdump /tmp/mathprint-editor-fraction-construct-post.ram ram-logical
screenshot /tmp/mathprint-editor-fraction-construct-post.png
