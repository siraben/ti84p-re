# Store zero in Ans, then run AARUN = Asm(prgmONBLOCK). The installed timer
# interrupt is allowed to fire; no ON-key event is injected after installation.
set key_hold 0.18s
set key_delay 0.10s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key 0
key ENTER
wait 1s
key PRGM
wait 0.6s
key ENTER
wait 0.8s
key ENTER
wait 4s
memdump /tmp/community-onblock-install.ram ram-logical
screenshot /tmp/community-onblock-install.png
