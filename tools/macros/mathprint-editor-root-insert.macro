# Capture adjacent live editor states around an ordinary root-leaf insertion.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key 1
wait 0.6s
memdump /tmp/mathprint-editor-root-insert-pre.ram ram-logical
screenshot /tmp/mathprint-editor-root-insert-pre.png
key 2
wait 0.6s
memdump /tmp/mathprint-editor-root-insert-post.ram ram-logical
screenshot /tmp/mathprint-editor-root-insert-post.png
