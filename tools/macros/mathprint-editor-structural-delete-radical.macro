# Delete a blank radical from its only child.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key 2ND
key SQUARE
wait 0.6s
memdump /tmp/mathprint-editor-structural-delete-radical-pre.ram ram-logical
screenshot /tmp/mathprint-editor-structural-delete-radical-pre.png
key DEL
wait 0.8s
memdump /tmp/mathprint-editor-structural-delete-radical-post.ram ram-logical
screenshot /tmp/mathprint-editor-structural-delete-radical-post.png
