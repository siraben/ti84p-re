# Capture the live graph with the cursor before the empty numerator token.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key ALPHA
key YEQU
wait 0.8s
key 1
wait 0.8s
wait 0.6s
memdump /tmp/mathprint-editor-fraction-empty.ram ram-logical
screenshot /tmp/mathprint-editor-fraction-empty.png
