# Insert fnInt( with a 20-digit integrand and walk the cursor across the
# whole template, forcing the MathPrint compositor's window-advance path
# (action 0x08 at 39:50A4) and multi-argument walks (39:5167).
#
#   $TILEM --headless --rom tools/rom.bin --model ti84p --normal-speed --reset \
#     --macro tools/macros/mathprint-fnint-wide-walk.macro \
#     --trace /tmp/fnint-wide.trace --trace-range all
#
# fnInt( = MATH menu item 9. X = GRAPHVAR key. Arrow runs get 0.35s gaps so
# the OS key scanner cannot coalesce adjacent identical presses.
set key_hold 0.15s
set key_delay 0.08s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
wait 0.5s
key MATH
wait 1s
key 9
wait 1.5s
# integrand: 20 digits, no two adjacent alike
key 1
key 2
key 3
key 4
key 5
key 6
key 7
key 8
key 9
key 0
key 1
key 2
key 3
key 4
key 5
key 6
key 7
key 8
key 9
key 0
wait 0.5s
# var, lower, upper
key GRAPHVAR
key COMMA
key 1
key COMMA
key 9
key RPAREN
wait 1s
# walk cursor to the far left, then back right, twice
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
key LEFT
wait 0.35s
wait 0.6s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
key RIGHT
wait 0.35s
