# Capture fraction-template insertion into an empty outer numerator.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key ALPHA
key YEQU
wait 0.4s
key 1
wait 0.6s
memdump /tmp/mathprint-editor-fraction-nested-blank-pre.ram ram-logical
screenshot /tmp/mathprint-editor-fraction-nested-blank-pre.png
key ALPHA
key YEQU
wait 0.4s
key 1
wait 0.8s
memdump /tmp/mathprint-editor-fraction-nested-blank-post.ram ram-logical
screenshot /tmp/mathprint-editor-fraction-nested-blank-post.png
