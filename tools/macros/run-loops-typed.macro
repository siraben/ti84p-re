# Create program "77" containing For(/While/Repeat( loops over theta, then
# run it. Used to trace the parser's OPS/FPS loop-frame records (page 38).
#
#   $TILEM --headless --rom tools/rom.bin --model ti84p --normal-speed --reset \
#     --macro tools/macros/run-loops-typed.macro \
#     --trace /tmp/loops.trace --trace-range all
#
# theta = ALPHA+3 (green char above 3), avoiding the letter keys entirely.
# CTL menu: 4=For( 5=While 6=Repeat 7=End. TEST menu: 3=< 6=>=.
set key_hold 0.15s
set key_delay 0.08s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
wait 0.5s
# --- create new program named 77 ---
key PRGM
wait 0.8s
key RIGHT
wait 0.4s
key RIGHT
wait 0.8s
key ENTER
wait 2.5s
key 7
wait 0.3s
key 7
wait 0.4s
key ENTER
wait 3s
# --- line 1: For(theta,1,3) ---
key PRGM
wait 0.8s
key 4
wait 0.6s
key ALPHA
key 3
key COMMA
key 1
key COMMA
key 3
key RPAREN
wait 0.4s
key ENTER
wait 0.6s
# --- line 2: End ---
key PRGM
wait 0.8s
key 7
wait 0.6s
key ENTER
wait 0.6s
# --- line 3: 0->theta ---
key 0
key STORE
key ALPHA
key 3
wait 0.4s
key ENTER
wait 0.6s
# --- line 4: While theta<3 ---
key PRGM
wait 0.8s
key 5
wait 0.6s
key ALPHA
key 3
key 2ND
key MATH
wait 0.6s
key 3
wait 0.6s
key 3
wait 0.4s
key ENTER
wait 0.6s
# --- line 5: theta+1->theta ---
key ALPHA
key 3
key ADD
key 1
key STORE
key ALPHA
key 3
wait 0.4s
key ENTER
wait 0.6s
# --- line 6: End ---
key PRGM
wait 0.8s
key 7
wait 0.6s
key ENTER
wait 0.6s
# --- line 7: 0->theta ---
key 0
key STORE
key ALPHA
key 3
wait 0.4s
key ENTER
wait 0.6s
# --- line 8: Repeat theta>=2 ---
key PRGM
wait 0.8s
key 6
wait 0.6s
key ALPHA
key 3
key 2ND
key MATH
wait 0.6s
key 6
wait 0.6s
key 2
wait 0.4s
key ENTER
wait 0.6s
# --- line 9: theta+1->theta ---
key ALPHA
key 3
key ADD
key 1
key STORE
key ALPHA
key 3
wait 0.4s
key ENTER
wait 0.6s
# --- line 10: End ---
key PRGM
wait 0.8s
key 7
wait 0.6s
key ENTER
wait 0.6s
# --- quit editor ---
key 2ND
key MODE
wait 1.2s
# --- run program 77 ---
key CLEAR
wait 0.4s
key PRGM
wait 1s
key ENTER
wait 1s
key ENTER
wait 6s
memdump /tmp/loops-final.ram ram-logical
screenshot /tmp/loops.png
