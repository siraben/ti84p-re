# Probe: create program named "77" (digits only), then type ALPHA+key for
# each candidate key name in order; one screenshot reveals the real mapping.
set key_hold 0.15s
set key_delay 0.08s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
wait 0.5s
key PRGM
wait 0.8s
key RIGHT
wait 0.4s
key RIGHT
wait 0.8s
key ENTER
wait 2.5s
key 7
wait 0.3s
key 7
wait 0.4s
key ENTER
wait 3s
key ALPHA
key MATH
wait 0.3s
key ALPHA
key MATRIX
wait 0.3s
key ALPHA
key PRGM
wait 0.3s
key ALPHA
key VARS
wait 0.3s
key ALPHA
key POWER
wait 0.3s
key ALPHA
key RECIP
wait 0.3s
key ALPHA
key SIN
wait 0.3s
key ALPHA
key COS
wait 0.3s
key ALPHA
key TAN
wait 0.3s
key ALPHA
key SQUARE
wait 0.3s
key ALPHA
key COMMA
wait 0.3s
key ALPHA
key LPAREN
wait 0.3s
key ALPHA
key RPAREN
wait 0.3s
key ALPHA
key DIV
wait 0.3s
key ALPHA
key LOG
wait 0.3s
key ALPHA
key LN
wait 0.3s
key ALPHA
key STORE
wait 0.3s
key ALPHA
key 7
wait 0.3s
key ALPHA
key 8
wait 0.3s
key ALPHA
key 9
wait 0.3s
key ALPHA
key MUL
wait 0.3s
key ALPHA
key SUB
wait 0.3s
key ALPHA
key 4
wait 0.3s
key ALPHA
key 5
wait 0.3s
key ALPHA
key 6
wait 0.3s
key ALPHA
key ADD
wait 0.3s
key ALPHA
key 1
wait 0.3s
key ALPHA
key 2
wait 0.4s
