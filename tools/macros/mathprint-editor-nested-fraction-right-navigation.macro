# Walk right through a fraction nested in an outer fraction numerator.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key ALPHA
key YEQU
wait 0.4s
key 1
wait 0.4s
key ALPHA
key YEQU
wait 0.4s
key 1
wait 0.4s
key 1
key RIGHT
key 2
key RIGHT
key RIGHT
key 3
key RIGHT
wait 0.5s
key LEFT
key LEFT
key LEFT
key LEFT
key LEFT
key LEFT
key LEFT
key LEFT
key LEFT
wait 0.5s
memdump /tmp/mp-nested-fraction-right-walk-0.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-0.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-1.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-1.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-2.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-2.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-3.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-3.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-4.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-4.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-5.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-5.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-6.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-6.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-7.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-7.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-8.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-8.png
key RIGHT
wait 0.4s
memdump /tmp/mp-nested-fraction-right-walk-9.ram ram-logical
screenshot /tmp/mp-nested-fraction-right-walk-9.png
key RIGHT
wait 0.4s
