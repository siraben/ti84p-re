# Walk left across a completed fraction, then test DEL before its marker.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key ALPHA
key YEQU
wait 0.4s
key 1
wait 0.4s
key 1
wait 0.4s
key RIGHT
wait 0.4s
key 2
wait 0.4s
key RIGHT
wait 0.5s
memdump /tmp/mp-struct-delete-walk-0.ram ram-logical
screenshot /tmp/mp-struct-delete-walk-0.png
key LEFT
wait 0.4s
memdump /tmp/mp-struct-delete-walk-1.ram ram-logical
screenshot /tmp/mp-struct-delete-walk-1.png
key LEFT
wait 0.4s
memdump /tmp/mp-struct-delete-walk-2.ram ram-logical
screenshot /tmp/mp-struct-delete-walk-2.png
key LEFT
wait 0.4s
memdump /tmp/mp-struct-delete-walk-3.ram ram-logical
screenshot /tmp/mp-struct-delete-walk-3.png
key LEFT
wait 0.4s
memdump /tmp/mp-struct-delete-walk-4.ram ram-logical
screenshot /tmp/mp-struct-delete-walk-4.png
key LEFT
wait 0.4s
memdump /tmp/mp-struct-delete-walk-5.ram ram-logical
screenshot /tmp/mp-struct-delete-walk-5.png
key LEFT
wait 0.4s
memdump /tmp/mp-struct-delete-walk-6.ram ram-logical
screenshot /tmp/mp-struct-delete-walk-6.png
key DEL
wait 0.8s
memdump /tmp/mp-struct-delete-walk-7.ram ram-logical
screenshot /tmp/mp-struct-delete-walk-7.png
