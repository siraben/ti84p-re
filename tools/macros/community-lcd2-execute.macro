# Run AARUN = Asm(prgmLCD2), let its calibration code execute, then request
# its documented foreground exit. No external link or USB input is present.
set key_hold 0.18s
set key_delay 0.10s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key PRGM
wait 0.6s
key ENTER
wait 0.8s
key ENTER
wait 6s
memdump /tmp/community-lcd2-execute.ram ram-logical
screenshot /tmp/community-lcd2-execute.png
key CLEAR
wait 2s
