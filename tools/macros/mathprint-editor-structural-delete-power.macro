# Delete a blank power exponent while retaining the implicit Ans base.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key POWER
wait 0.6s
memdump /tmp/mathprint-editor-structural-delete-power-pre.ram ram-logical
screenshot /tmp/mathprint-editor-structural-delete-power-pre.png
key DEL
wait 0.8s
memdump /tmp/mathprint-editor-structural-delete-power-post.ram ram-logical
screenshot /tmp/mathprint-editor-structural-delete-power-post.png
