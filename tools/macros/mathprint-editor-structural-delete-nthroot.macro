# Delete an empty nth-root radicand and promote its explicit index.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key 2
key MATH
key 5
wait 0.6s
memdump /tmp/mathprint-editor-structural-delete-nthroot-pre.ram ram-logical
screenshot /tmp/mathprint-editor-structural-delete-nthroot-pre.png
key DEL
wait 0.8s
memdump /tmp/mathprint-editor-structural-delete-nthroot-post.ram ram-logical
screenshot /tmp/mathprint-editor-structural-delete-nthroot-post.png
