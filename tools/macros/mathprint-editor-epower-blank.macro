# Capture e-power insertion into a blank root leaf.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
wait 0.6s
memdump /tmp/mathprint-editor-epower-blank-pre.ram ram-logical
screenshot /tmp/mathprint-editor-epower-blank-pre.png
key 2ND
key LN
wait 0.8s
memdump /tmp/mathprint-editor-epower-blank-post.ram ram-logical
screenshot /tmp/mathprint-editor-epower-blank-post.png
