# Capture a fraction-denominator leaf nested in an integral-body leaf.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key MATH
key 9
key 1
key RIGHT
wait 0.35s
key 2
key RIGHT
wait 0.35s
key ALPHA
key YEQU
wait 0.8s
key 1
wait 0.8s
key 1
key DOWN
wait 0.35s
key 2
wait 0.6s
memdump /tmp/mathprint-editor-nested-fraction-denominator.ram ram-logical
screenshot /tmp/mathprint-editor-nested-fraction-denominator.png
