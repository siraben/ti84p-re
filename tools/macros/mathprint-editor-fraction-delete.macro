# Capture empty-slot restoration after deleting the sole fraction numerator.
set key_hold 0.18s
set key_delay 0.1s
wait 4s
key ON
wait 3s
key ENTER
wait 1.5s
key CLEAR
key ALPHA
key YEQU
wait 0.8s
key 1
wait 0.8s
key 2
key LEFT
wait 0.6s
memdump /tmp/mathprint-editor-fraction-delete-pre.ram ram-logical
screenshot /tmp/mathprint-editor-fraction-delete-pre.png
key DEL
wait 0.6s
memdump /tmp/mathprint-editor-fraction-delete-post.ram ram-logical
screenshot /tmp/mathprint-editor-fraction-delete-post.png
